# Site
NEXT_PUBLIC_SITE_URL=https://portfolio-website-brandan.vercel.app

# Booking: optional override for the 30-min discovery call link (defaults to cal.com/brandan-pratt-eytpru/30min)
NEXT_PUBLIC_CAL_URL=

# "Ask Brandan" chat — Vercel AI Gateway. On Vercel, OIDC auth works automatically;
# locally run `vercel env pull` or set an API key.
AI_GATEWAY_API_KEY=
# Optional model override (default: anthropic/claude-haiku-5.5)
CHAT_MODEL=

# Contact form (Resend)
RESEND_API_KEY=
CONTACT_EMAIL=brandan.pratt1@gmail.com
# Use a verified domain sender once you have one, e.g. "Brandan Pratt <hello@yourdomain.com>"
CONTACT_FROM=

# GitHub Pulse (optional; enables the contribution heatmap and higher rate limits)
# Fine-grained token with read-only public access is enough.
GITHUB_TOKEN=

# Google Search Console (optional)
GOOGLE_SITE_VERIFICATION=
